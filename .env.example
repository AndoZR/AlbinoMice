# Nomor WhatsApp penjual, format internasional tanpa "+" (contoh: 6281234567890)
NEXT_PUBLIC_WA_NUMBER=6281216532315

# Dipakai untuk sitemap.xml dan URL absolut di metadata.
NEXT_PUBLIC_SITE_URL=https://albinomice.id

# Supabase — opsional. Tanpa dua variabel ini, situs memakai data contoh di lib/data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Password dashboard admin (jangan dibagikan). Dipakai bersama cookie sesi admin.
ADMIN_PASSWORD=ganti-dengan-password-kuat
